<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PianoPractice.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Piano Practice">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        PaneDisplayMode="Left"
        SelectionChanged="Nav_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Live" Tag="Live" Icon="Audio" />
            <NavigationViewItem Content="Note reading" Tag="NoteReading" Icon="Read" />
            <NavigationViewItem Content="Intervals" Tag="Intervals" Icon="Volume" />
            <NavigationViewItem Content="Play-along" Tag="PlayAlong" Icon="Play" />
        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,8"
                        ToolTipService.ToolTip="{x:Bind Shell.StatusText, Mode=OneWay}">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                         Fill="{x:Bind StatusBrush(Shell.IsConnected), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Shell.StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </NavigationView.PaneFooter>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
