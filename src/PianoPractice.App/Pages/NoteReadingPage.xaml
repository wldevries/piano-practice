<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PianoPractice.App.Pages.NoteReadingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PianoPractice.App.Controls"
    Unloaded="Page_Unloaded">

    <Grid Padding="36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Note reading" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Read the note on the staff and play it. Notes you find hard come up more often." />
        </StackPanel>

        <!-- Setup -->
        <ScrollViewer Grid.Row="1" Visibility="{x:Bind ViewModel.IsSetup, Mode=OneWay}">
            <Grid ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="14">
                    <ComboBox Header="Clef" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.ClefOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedClefIndex, Mode=TwoWay}" />
                    <ComboBox Header="Range" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.LedgerOptions}"
                              SelectedIndex="{x:Bind ViewModel.SelectedLedgerIndex, Mode=TwoWay}" />
                    <ComboBox Header="Key signature" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Keys}"
                              SelectedItem="{x:Bind ViewModel.SelectedKey, Mode=TwoWay}" />
                    <ToggleSwitch Header="Sharps, flats and naturals" IsOn="{x:Bind ViewModel.IncludeAccidentals, Mode=TwoWay}" />
                    <ToggleSwitch Header="Octave must match" IsOn="{x:Bind ViewModel.RequireExactOctave, Mode=TwoWay}" />
                    <NumberBox Header="Notes per session" Minimum="5" Maximum="200" SmallChange="5" LargeChange="10"
                               SpinButtonPlacementMode="Inline"
                               Value="{x:Bind ViewModel.CardsPerSession, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.DeckSizeText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="Start" Style="{StaticResource AccentButtonStyle}" MinWidth="140"
                            Command="{x:Bind ViewModel.StartCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Recent sessions" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Margin="0,2"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Running -->
        <Grid Grid.Row="1" RowSpacing="12" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="Skip" Command="{x:Bind ViewModel.SkipCommand}" />
                <Button Grid.Column="3" Content="Stop" Command="{x:Bind ViewModel.StopCommand}" />
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:GrandStaff Notes="{x:Bind ViewModel.StaffNotes, Mode=OneWay}"
                                     Key="{x:Bind ViewModel.StaffKey, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.FeedbackText, Mode=OneWay}" TextWrapping="Wrap"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Summary -->
        <Grid Grid.Row="1" ColumnSpacing="48" Visibility="{x:Bind ViewModel.IsSummary, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="48">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SummaryAccuracy, Mode=OneWay}" FontSize="64" FontWeight="SemiBold" />
                        <TextBlock Text="right first time" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SummaryTime, Mode=OneWay}" FontSize="64" FontWeight="SemiBold" />
                        <TextBlock Text="average answer time" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.SummaryDetail, Mode=OneWay}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="520"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button Content="Again" Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                            Command="{x:Bind ViewModel.AgainCommand}" />
                    <Button Content="Change settings" Command="{x:Bind ViewModel.BackToSetupCommand}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Needs work (all sessions)" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.TroubleNotes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="The keyboard shows your accuracy per key over all sessions: green is solid, red needs work." />
            </StackPanel>
        </Grid>

        <controls:PianoKeyboard
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsKeyboardVisible, Mode=OneWay}"
            Highlights="{x:Bind ViewModel.Highlights, Mode=OneWay}"
            KeyPressed="Keyboard_KeyPressed"
            KeyReleased="Keyboard_KeyReleased" />
    </Grid>
</Page>
