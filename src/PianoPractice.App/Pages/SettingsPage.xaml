<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PianoPractice.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Unloaded="Page_Unloaded">

    <StackPanel Padding="36,24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="MIDI" />

        <ComboBox Header="Input (from the piano)" MinWidth="320"
                  ItemsSource="{x:Bind ViewModel.Inputs}"
                  SelectedItem="{x:Bind ViewModel.SelectedInput, Mode=TwoWay}" />

        <ComboBox Header="Output (to the piano)" MinWidth="320"
                  ItemsSource="{x:Bind ViewModel.Outputs}"
                  SelectedItem="{x:Bind ViewModel.SelectedOutput, Mode=TwoWay}" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Refresh devices" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Content="Test sound" Command="{x:Bind ViewModel.TestSoundCommand}" />
        </StackPanel>

        <InfoBar IsOpen="{x:Bind HasText(ViewModel.ErrorText), Mode=OneWay}" IsClosable="False"
                 Severity="Error" Title="MIDI" Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
    </StackPanel>
</Page>
