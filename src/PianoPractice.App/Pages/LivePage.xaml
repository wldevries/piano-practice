<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PianoPractice.App.Pages.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PianoPractice.App.Controls"
    Unloaded="Page_Unloaded">

    <Grid Padding="36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Live" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Play anything on the piano, or click the keys below." />
            </StackPanel>
            <ComboBox Grid.Column="1" Header="Key" MinWidth="240" VerticalAlignment="Bottom"
                      ItemsSource="{x:Bind ViewModel.Keys}"
                      SelectedItem="{x:Bind ViewModel.SelectedKey, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:GrandStaff
                Notes="{x:Bind ViewModel.StaffNotes, Mode=OneWay}"
                Key="{x:Bind ViewModel.SelectedKey, Mode=OneWay}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.ChordName, Mode=OneWay}"
                           FontSize="96" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.NoteNamesText, Mode=OneWay}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Padding="10,4" CornerRadius="4"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="{x:Bind ViewModel.IsSustainOn, Mode=OneWay}">
                <TextBlock Text="Pedal" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
        </Grid>

        <controls:PianoKeyboard
            Grid.Row="2"
            Highlights="{x:Bind ViewModel.Highlights, Mode=OneWay}"
            KeyPressed="Keyboard_KeyPressed"
            KeyReleased="Keyboard_KeyReleased" />
    </Grid>
</Page>
